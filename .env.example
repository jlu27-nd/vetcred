# Browser-safe Supabase project URL and publishable key (preview project only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side alias used by setup scripts; same project as the browser URL.
SUPABASE_URL=
# Prefer the current Supabase secret key. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional legacy server fallback if a current secret key is unavailable.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only transaction-pooler database URL for the application.
POSTGRES_URL=
# Server-only session/non-pooling URL for migrations, seed and integration tests.
POSTGRES_URL_NON_POOLING=
# Required setup guard: must match Supabase URL and database host/username.
# Use the separate preview project's reference, never the production reference.
VETCRED_PREVIEW_PROJECT_REF=

# Server-only Gateway model IDs. Current preview choices:
# generation: openai/gpt-5.4-nano; transcription: openai/gpt-transcribe.
AI_GENERATION_MODEL=
AI_TRANSCRIPTION_MODEL=
# Optional local/CI Gateway key. Leave unset when using Vercel OIDC.
AI_GATEWAY_API_KEY=
# Vercel injects this for deployments; vercel env pull supplies a temporary local token.
# Never hardcode or commit the token. Refresh local OIDC when it expires.
VERCEL_OIDC_TOKEN=

# Optional test switches. Real DB/provider suites run only when these equal 1.
# Never enable with production data or in an untrusted pull-request environment.
VETCRED_RUN_DB_TESTS=
VETCRED_RUN_LIVE_E2E=
# Optional deployed preview URL; defaults to local development when empty.
PLAYWRIGHT_BASE_URL=
# Optional protected-preview test access. Requires a valid local OIDC token;
# the journey suite sends it only to the selected .vercel.app preview origin.
VETCRED_USE_PREVIEW_OIDC=
